<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">@color/blue_dark</item>
        <item name="android:navigationBarColor">@color/blue_dark</item>
        <item name="android:colorAccent">@color/orange_accent</item>
    </style>

    <style name="AppDialogLight" parent="android:style/Theme.Material.Light.Dialog.Alert">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">@color/black_primary</item>
    </style>

    <style name="AppDialogDark" parent="android:style/Theme.Material.Dialog.Alert">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">@color/white_primary</item>
    </style>
</resources>
